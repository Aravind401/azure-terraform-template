# Local .terraform directories
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# .tfvars files (sensitive data)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Backup files
*.backup
*.bak

# Operating system files
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE files
.vscode/
.idea/
*.sublime-*